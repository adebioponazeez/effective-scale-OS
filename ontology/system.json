  "claims": [
    {
      "id": "C-stdlib",
      "statement": "source under src/ imports only the Python standard library",
      "check": "stdlib_only",
      "severity": "high"
    },
    {
      "id": "C-routes",
      "statement": "every route documented in docs/09-api-reference.md is registered, and every registered route is documented",
      "check": "routes",
      "severity": "high"
    },
    {
      "id": "C-states",
      "statement": "every state machine declared in this ontology matches the enums and transition tables in code",
      "check": "states",
      "severity": "high"
    },
    {
      "id": "C-persist",
      "statement": "every persisted entity has a store persister and a table",
      "check": "persisters",
      "severity": "medium"
    },
    {
      "id": "C-caps",
      "statement": "every capability declared here is satisfied by the resources this ontology names (or explicitly unimplemented)",
      "check": "capabilities",
      "severity": "high"
    },
    {
      "id": "C-deadcode",
      "statement": "no module is unreachable: every source module is referenced outside its own package or declared dormant with a reason",
      "check": "dead_modules",
      "severity": "medium"
    },
    {
      "id": "C-invariants",
      "statement": "every invariant names an enforcement point and a test that exists",
      "check": "invariants",
      "severity": "high"
    },
    {
      "id": "C-test-counts",
      "statement": "test counts stated in the READMEs match the tests actually discoverable",
      "check": "test_counts",
      "severity": "low"
    },
    {
      "id": "C-versions",
      "statement": "product versions are declared once: __init__.py, pyproject, the ontology and the deploy manifests (image tags) agree, and no other source file hardcodes a version literal",
      "check": "versions",
      "severity": "medium"
    },
    {
      "id": "C-ops",
      "statement": "every deployment artifact declares a restart policy and wires a health probe to /v1/health/ready (readiness) and /v1/health/live (liveness)",
      "check": "operations",
      "severity": "high"
    }
  ],
