# Copy to /etc/effective-scale/effective-scale.env and edit. Keep it 0600, owned by root.
ES_LISTEN=0.0.0.0:8080
# >= 16 chars; HMAC key for issued tokens. Rotate by issuing new tokens, not by editing this.
ES_AUTH_SECRET=replace-with-a-32-byte-random-secret
# Bootstrap admin header token: only used to mint the first scoped token (POST /v1/tokens).
# Remove it after bootstrapping if you do not want a standing bootstrap credential.
ES_ADMIN_TOKEN=replace-with-a-one-time-bootstrap-token
